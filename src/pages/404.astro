---
import Base from '../layouts/Base.astro';
---

<Base title="Page Not Found">

  <div class="bg-white border border-purple-200 rounded-xl p-5 mb-4 shadow-sm text-center">

    <h1 class="text-4xl font-bold text-purple-900 mb-3">404</h1>

    <p class="text-lg text-purple-700 mb-6">
      Sorry, that page doesn't exist.
    </p>

    <a href="/" class="inline-block bg-purple-700 text-white font-semibold rounded-lg px-6 py-2 text-sm hover:bg-purple-800">
      &larr; Back to Home
    </a>

  </div>

</Base>