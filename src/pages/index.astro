---
import Base from '../layouts/Base.astro';
import DigestCard from '../components/DigestCard.astro';
import { getDigests } from '../lib/api';

const digests = await getDigests();
---

<Base>

  {digests.length === 0 && (
    <div class="bg-white border border-purple-200 rounded-xl p-6 text-center text-purple-400">
      No digests yet — the first one is on the way!
    </div>
  )}

  {digests.map((digest: any) => (
    <DigestCard digest={digest} />
  ))}




  <main class="max-w-3xl mx-auto px-4 py-8">
  <!-- Page Title & Stats Bar -->
  <section class="mb-6 pb-4 border-b border-purple-200 flex items-center justify-between">
    <h1 class="text-xl font-bold text-purple-950">Recent News Digests</h1>
    <span class="text-xs font-semibold px-2.5 py-1 bg-purple-200 text-purple-800 rounded-full">
      Showing 30 Digests
    </span>
  </section>

  <!-- Digest Links Feed -->
  <div class="space-y-3">

    <!-- Digest Card Item (Repeatable Template) -->
    <a href="/daily-general-news-digest-for-psn-digest-2026-08-31" 
       class="group block bg-white hover:bg-purple-100/60 border border-purple-200/80 hover:border-purple-300 rounded-lg p-4 transition-all duration-150 shadow-sm hover:shadow-md">
      <div class="flex items-center justify-between gap-4">
        
        <!-- Left: Date & Details -->
        <div class="space-y-1">
          <div class="font-semibold text-purple-950 group-hover:text-purple-700 flex items-center gap-2">
            <span>Monday, August 31, 2026</span>
            <span class="text-xs font-normal text-purple-500 group-hover:text-purple-700 transition-colors">
              &bull; Today
            </span>
          </div>
          <div class="text-xs text-purple-600 flex items-center gap-3">
            <span><strong>20</strong> items</span>
            <span>&bull;</span>
            <span><strong>1</strong> source</span>
          </div>
        </div>

        <!-- Right: Clear Action Indicator -->
        <div class="shrink-0 text-purple-400 group-hover:text-purple-700 group-hover:translate-x-0.5 transition-all">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </div>

      </div>
    </a>

    <!-- Example Digest Card Item 2 -->
    <a href="/daily-general-news-digest-for-psn-digest-2026-08-30" 
       class="group block bg-white hover:bg-purple-100/60 border border-purple-200/80 hover:border-purple-300 rounded-lg p-4 transition-all duration-150 shadow-sm hover:shadow-md">
      <div class="flex items-center justify-between gap-4">
        <div class="space-y-1">
          <div class="font-semibold text-purple-950 group-hover:text-purple-700">
            Sunday, August 30, 2026
          </div>
          <div class="text-xs text-purple-600 flex items-center gap-3">
            <span><strong>18</strong> items</span>
            <span>&bull;</span>
            <span><strong>2</strong> sources</span>
          </div>
        </div>
        <div class="shrink-0 text-purple-400 group-hover:text-purple-700 group-hover:translate-x-0.5 transition-all">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </div>
      </div>
    </a>

    <!-- Example Digest Card Item 3 -->
    <a href="/daily-general-news-digest-for-psn-digest-2026-08-29" 
       class="group block bg-white hover:bg-purple-100/60 border border-purple-200/80 hover:border-purple-300 rounded-lg p-4 transition-all duration-150 shadow-sm hover:shadow-md">
      <div class="flex items-center justify-between gap-4">
        <div class="space-y-1">
          <div class="font-semibold text-purple-950 group-hover:text-purple-700">
            Saturday, August 29, 2026
          </div>
          <div class="text-xs text-purple-600 flex items-center gap-3">
            <span><strong>24</strong> items</span>
            <span>&bull;</span>
            <span><strong>3</strong> sources</span>
          </div>
        </div>
        <div class="shrink-0 text-purple-400 group-hover:text-purple-700 group-hover:translate-x-0.5 transition-all">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </div>
      </div>
    </a>

  </div>
</main>





</Base>