---
import Base from '../layouts/Base.astro';
import DigestCard from '../components/DigestCard.astro';
import { getDigests } from '../lib/api';

const digests = await getDigests();
---

<Base>

  <section class="mb-6 pb-4 border-b border-purple-200 flex items-center justify-between">
    <h1 class="text-xl font-bold text-purple-950">Recent Digests</h1>
    {digests.length > 0 && (
      <span class="text-xs font-semibold px-2.5 py-1 bg-purple-200 text-purple-800 rounded-full">
        Showing {digests.length} {digests.length === 1 ? 'Digest' : 'Digests'}
      </span>
    )}
  </section>

  {digests.length === 0 && (
    <div class="bg-white border border-purple-200 rounded-lg p-6 text-center text-purple-400">
      No digests yet — the first one is on the way!
    </div>
  )}

  <div class="space-y-3">
    {digests.map((digest: any, index: number) => (
      <DigestCard digest={digest} isFirst={index === 0} />
    ))}
  </div>

</Base>