---
import { getList } from '../lib/api';

interface Props {
  title?: string;
}

const { title } = Astro.props;

const digestListName = import.meta.env.DIGEST_NAME;
const list = await getList();

const pageTitle = title ? `${title} · ${list.name}` : list.name;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <link href="/css/tailwind.min.css" rel="stylesheet" />
  </head>

  <body class="bg-purple-50 text-purple-900" style="font-family: 'Georgia', serif;">

    <!-- Header -->
    <header class="bg-purple-100 border-b border-purple-200 px-4 py-3">
      <div class="max-w-3xl mx-auto flex items-center gap-3">
          <a href="/">
            <img
              src="https://psn-images.bobbloompodcasts.com/phpserverlessnews_logo_3000x3000.png"
              alt={digestListName}
              class="object-cover"
              style="width: 52px; height: 52px;"
            />
          </a>
        <div>
          <div class="font-bold text-lg text-purple-900 leading-tight">
            <a href="/">{digestListName}</a>
          </div>
        </div>
      </div>
    </header>

    <!-- Main content -->
    <main class="max-w-3xl mx-auto px-4 py-6">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-purple-100 border-t border-purple-200 mt-8 px-4 py-6">
       <div class="max-w-3xl mx-auto text-center text-sm text-purple-600 space-y-2"> 
    
        <!-- Footer links --> 
        <nav class="flex flex-col items-center gap-y-2 mb-4">
          <a href="https://bobbloomshow.com/" class="text-purple-600 hover:text-purple-900 hover:underline">Bob Bloom Show</a>
          
          <a href="https://phpserverlessnews.com" class="text-purple-600 hover:text-purple-900 hover:underline">PHP Serverless News Podcast </a>
          
          <a href="https://phpserverlessprofiles.com" class="text-purple-600 hover:text-purple-900 hover:underline">PHP Serverless Profiles Podcast </a>
          
          <a href="https://bobbloominterviews.com" class="text-purple-600 hover:text-purple-900 hover:underline">The Bob Bloom Interviews Podcast </a>
              
          <a href="https://github.com/local-toronto-php-groups/" class="text-purple-600 hover:text-purple-900 hover:underline"> I organize these Toronto area PHP Groups </a>
        </nav>
        
        <p class="text-black mt-4">&copy; 2026 - {new Date().getFullYear()} South LaSalle Trading Corporation</p>

      </div>
    </footer> 

  </body>
</html>