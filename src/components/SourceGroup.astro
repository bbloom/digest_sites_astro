---
interface Props {
  group: any;
}

const { group } = Astro.props;

function formatDate(dateStr: string): string {
  return new Date(dateStr).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}

function sourceTypeLabel(sourceType: string): string {
  const labels: Record<string, string> = {
    youtube_channel: 'YouTube',
    podcast:         'Podcast',
    text_based_rss:  'RSS',
  };
  return labels[sourceType] ?? sourceType;
}

function stripHtml(html: string): string {
  return html.replace(/<[^>]*>/g, '').replace(/\s+/g, ' ').trim();
}

function shouldShowDescription(item: any): boolean {
  if (!item.source_description) return false;
  if (!item.summary_html) return true;
  return stripHtml(item.source_description) !== stripHtml(item.summary_html);
}
---

<div class="mb-6">

  <!-- Source header -->
  <div class="bg-purple-100 border border-purple-200 rounded-t-xl px-5 py-3">
    <h2 class="font-bold text-purple-900">{group.source_name}</h2>
    {group.source_type && (
      <span class="text-xs text-purple-500">{sourceTypeLabel(group.source_type)}</span>
    )}
  </div>

  <!-- Items -->
  {(group.items ?? []).map((item: any, index: number) => {
    const itemId = `item-${group.source_name.replace(/\s+/g, '-')}-${index}`;
    const showDesc = shouldShowDescription(item);
    return (
      <div class="bg-white border-l border-r border-b border-purple-200 px-5 py-3 last:rounded-b-xl">

        <!-- Title row -->
        <div class="flex items-start justify-between gap-3">

          <!-- Title + external link icon -->
          <h3 class="text-base font-bold text-purple-900 leading-snug">
            <a
              href={item.source_url}
              target="_blank"
              rel="noreferrer noopener"
              class="hover:text-purple-600 inline-flex items-center gap-1"
            >
              {item.source_title}
              <svg class="inline w-3.5 h-3.5 text-purple-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </h3>

          <!-- Show/Hide button -->
          <button
            onclick={`document.getElementById('${itemId}').classList.toggle('hidden')`}
            class="shrink-0 text-xs text-purple-500 hover:text-purple-700 border border-purple-200 hover:border-purple-400 rounded px-2 py-0.5 transition-colors"
          >
            Show
          </button>

        </div>

        <!-- Expandable detail -->
        <div id={itemId} class="hidden mt-3 space-y-2">

          {item.source_published_at && (
            <p class="text-xs text-purple-400">{formatDate(item.source_published_at)}</p>
          )}

          {showDesc && (
            <p class="text-sm text-purple-700 italic">{item.source_description}</p>
          )}

          {item.summary_html && (
            <div class="text-sm text-black leading-relaxed" set:html={item.summary_html} />
          )}

        </div>

      </div>
    );
  })}

</div>