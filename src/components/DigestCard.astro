---
interface Props {
  digest: any;
}

const { digest } = Astro.props;

function formatDate(dateStr: string): string {
  return new Date(dateStr + 'T00:00:00').toLocaleDateString('en-US', {
    weekday: 'long',
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<p class="mb-2">
  <a 
    href={`/${digest.slug}`} 
    class="text-purple-700 hover:underline"
  >
    {formatDate(digest.date)} ({digest.total_items} {digest.total_items === 1 ? 'item' : 'items'} from <span class="text-sm">{digest.source_count} {digest.source_count === 1 ? 'source' : 'sources'})</span>
  </a>
</p>