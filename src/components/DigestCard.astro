---
interface Props {
  digest: any;
}

const { digest } = Astro.props;

function formatDate(dateStr: string): string {
  return new Date(dateStr + 'T00:00:00').toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}

// Build a comma-separated list of source names for the subtitle
const sourceNames = (digest.groups ?? [])
  .map((g: any) => g.source_name)
  .join(', ');
---

<a href={`/${digest.slug}`} class="block">
  <div class="bg-white border border-purple-200 rounded-xl p-5 mb-4 shadow-sm hover:border-purple-400 transition-colors">

    <!-- Date -->
    <p class="text-xs text-purple-400 mb-1">
      {formatDate(digest.date)}
    </p>

    <!-- Title (date-based) -->
    <h2 class="text-lg font-bold text-purple-900 leading-snug mb-2">
      {digest.total_items} {digest.total_items === 1 ? 'item' : 'items'} from {digest.source_count} {digest.source_count === 1 ? 'source' : 'sources'}
    </h2>

    <!-- Source names -->
    {sourceNames && (
      <p class="text-sm text-purple-600 leading-relaxed">
        {sourceNames}
      </p>
    )}

  </div>
</a>